# Service config
PORT=8080
NODE_ENV=development
JWT_SECRET=change-this-to-a-long-random-string-in-production

# Database mode: 'sqlite' | 'cosmos'
DB_MODE=sqlite
SQLITE_PATH=/app/data/interactions.db

# Azure Cosmos DB
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=photoshare
COSMOS_CONTAINER_COMMENTS=comments
COSMOS_CONTAINER_RATINGS=ratings
COSMOS_CONTAINER_IMAGES=images

# Azure AI Search (used when SEARCH_MODE=azure)
SEARCH_MODE=local
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX=images-index

# URL of the auth-image-service (for cross-service search lookups in local mode)
AUTH_IMAGE_SERVICE_URL=http://auth-image-service:8080

# Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=

# CORS
CORS_ORIGIN=http://localhost:3000
