# ============================================================
# PhotoShare — environment variables
# Copy this file to ".env" (no extension) and fill values in.
# ============================================================

# ---- General ----
NODE_ENV=development
JWT_SECRET=please-change-me-to-a-long-random-string

# ---- CORS / public URLs (used when running locally) ----
CORS_ORIGIN=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8001
PUBLIC_AUTH_API=http://localhost:8001
PUBLIC_INTERACTION_API=http://localhost:8002

# ============================================================
# LOCAL MODE (default) — uses SQLite + local uploads
# Just run: docker-compose up --build
# ============================================================
STORAGE_MODE=local
DB_MODE=sqlite
SEARCH_MODE=local

# ============================================================
# AZURE MODE — flip these on once Azure resources are created.
# Set STORAGE_MODE=azure, DB_MODE=cosmos, SEARCH_MODE=azure
# and fill in the values below.
# ============================================================

# Azure Cosmos DB
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=photoshare

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=photos

# Azure AI Vision (auto-tagging)
AI_VISION_ENDPOINT=
AI_VISION_KEY=

# Azure AI Search (multi-field search)
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX=images-index

# Application Insights (monitoring)
APPLICATIONINSIGHTS_CONNECTION_STRING=
